<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Pleos Vehicle SDK 권한(조회만). 공모전·개발 단계에서는 선언만으로 에뮬레이터에서 호출된다(10/28 설명회).
      쉼표는 차량 상태 조회 + NaviHelper만 쓴다. 조회 항목이 늘면 해당 CAR_* 권한을 여기에 더한다.
    -->
    <!-- 좌석 점유(탑승 감지) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 기어 상태(P단) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name=".VehicleApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".VehicleActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
